# Copy to .env and fill in. Never committed.
#
# Either an RT you already have:
RT_URL=https://rt.example.com
RT_TOKEN=1-14-your-auth-token

# or the disposable one in docker-compose.yml, which has no tokens yet and so
# takes the root password RT ships with:
#
#   RT_URL=http://localhost:8091
#   RT_USER=root
#   RT_PASSWORD=password

# Include the creates, updates and deletes. They run against objects the suite
# makes and removes, never anything that was there beforehand -- but they
# write, so point them at the compose RT rather than one anyone depends on.
# `bin/test --mutate` is the same thing.
# RT_MUTATE=1
