#!/usr/bin/env bash
# One RSpec example per operation this document describes.
#
# `-g rt-rspec` is a custom generator (generators/rspec) that decides, per
# operation and from the document alone, which object to aim it at and what
# body to send. Nothing per-endpoint is written by hand: spec_helper.rb knows
# only how to make a request, check the status and validate the body.
set -euo pipefail

cd "$(dirname "$0")/.."

rm -rf spec/api

# `models` rather than models=false: the generator needs the request models
# in MEMORY to know which fields a create requires. None are written to disk
# -- the codegen clears modelTemplateFiles -- but without this they are never
# built, and every generated request body comes out empty.
openapi-generator-rt-rspec generate \
  -i request_tracker_rest2.yaml \
  -g rt-rspec \
  -o . \
  --global-property apis,apiTests=true,models,modelTests=false,supportingFiles=false \
  --additional-properties=gemName=rt,moduleName=RT

# The generator's own bookkeeping. NOT lib/: that is lib/schemas.rb, which
# builds openapi-ruby's components from the document and is not generated.
rm -rf .openapi-generator

echo
echo "generated:"
ls spec/api
